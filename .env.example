# =============================================================================
# outbound-lead-waterfall-router - environment configuration template
# -----------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and fill in values. NEVER commit real API keys,
# real lead lists or any personal data.
#
# ⚠️ Disclaimer & Liability Limitation: use at your own risk. The author and
# dhRobin Systems assume no responsibility or liability for any damages
# resulting from the use, misuse, or deployment of these scripts.
# See DISCLAIMER.md.
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true (default): no external API calls; deterministic mock responses and
# SIMULATED credit spend. Only false/0/no/off enable live calls. Anything else
# keeps sandbox ON.
SANDBOX_MODE=true

# --- Waterfall behaviour ------------------------------------------------------
# Paid tiers, cheapest / highest-yield first. The cache (tier 0) always runs
# before these. Known providers: apollo, clearbit
WATERFALL_ORDER=apollo,clearbit
# The waterfall stops as soon as ALL these fields are present at or above
# MIN_CONFIDENCE. Fields: email, emailStatus, firstName, lastName, fullName,
# title, seniority, linkedinUrl, companyName, companyDomain, industry,
# employeeCount, country
REQUIRED_FIELDS=email,title,companyDomain
# 0-1. Confidence of the weakest provider that supplied a required field.
MIN_CONFIDENCE=0.7
# Leads processed in parallel (1-50). Provider rate limits still apply.
ENRICHMENT_CONCURRENCY=3
# Hard credit cap for one run across all providers. Paid tiers are skipped
# once it is reached (leads are marked budget_exhausted).
MAX_CREDITS_PER_RUN=500

# --- Tier 0: cache ----------------------------------------------------------------
# Positive results are reused for this many days.
CACHE_TTL_DAYS=30
# Confirmed "no match" results are remembered for this many days.
CACHE_NEGATIVE_TTL_DAYS=7
# Optional path for a persistent cache file (e.g. ./.cache/enrichment-cache.json).
# Empty = in-memory only. The file contains enriched personal data: keep it on
# encrypted storage and out of version control.
CACHE_FILE_PATH=
CACHE_MAX_ENTRIES=50000
# true = ignore the cache for this run (results are still written back).
FORCE_REFRESH=false

# --- Tier 1: Apollo (People Enrichment) -----------------------------------------
APOLLO_ENABLED=true
# Create in Apollo > Settings > Integrations > API. Needs access to
# api/v1/people/match. Leave empty in sandbox mode.
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
# Credits charged per successful match (no-match responses are treated as 0).
APOLLO_COST_PER_LOOKUP=1
# Keep below your plan's published limit; 429s are also handled automatically.
APOLLO_RATE_LIMIT_PER_MINUTE=50
APOLLO_RATE_LIMIT_BURST=5
APOLLO_TIMEOUT_MS=15000
APOLLO_MAX_RETRIES=3

# --- Tier 2: Clearbit (legacy) or a Clearbit-compatible fallback -----------------
# Standalone Clearbit API keys are only available to legacy (pre-2024)
# accounts. Point CLEARBIT_BASE_URL at a compatible endpoint, or disable.
CLEARBIT_ENABLED=true
CLEARBIT_API_KEY=
CLEARBIT_BASE_URL=https://person.clearbit.com
CLEARBIT_COST_PER_LOOKUP=1
CLEARBIT_RATE_LIMIT_PER_MINUTE=300
CLEARBIT_RATE_LIMIT_BURST=10
CLEARBIT_TIMEOUT_MS=15000
CLEARBIT_MAX_RETRIES=3

# --- Resilience (shared) --------------------------------------------------------
# Exponential backoff for retryable errors (429, 5xx, timeouts, network).
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=10000
# Consecutive failures before a provider is skipped, and for how long.
# Invalid API keys (401/403) disable the provider for the rest of the run.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=60000

# --- Logging -------------------------------------------------------------------------
# error | warn | info | debug. Emails are masked and secrets redacted at every level.
LOG_LEVEL=info
# json (log pipelines) | pretty (terminal)
LOG_FORMAT=json
